# ----------------------------------------------------------------------------
# Extras del NewBrain, desactivados. Para usar uno: descomentar su macro y
# sus pines, poniendo los PIN_xx libres de la placa. Sin la macro, el puerto
# no existe en el top y no hace falta asignarle pin.
# ----------------------------------------------------------------------------
# Puertos serie V24 e impresora, niveles TTL y reposo a 1 (para RS232,
# MAX3232 o similar). RTS y los CTS son activos a nivel bajo.
#set_global_assignment -name VERILOG_MACRO "NB_SERIE=1"
#set_location_assignment PIN_xx -to V24_TXD
#set_location_assignment PIN_xx -to V24_RTS
#set_location_assignment PIN_xx -to V24_RXD
#set_location_assignment PIN_xx -to V24_CTS
#set_location_assignment PIN_xx -to PRN_TXD
#set_location_assignment PIN_xx -to PRN_CTS
#
# Remote de las cintas, a 1 con el motor en marcha (transistor o rele)
#set_global_assignment -name VERILOG_MACRO "NB_REMOTE=1"
#set_location_assignment PIN_xx -to TAPE_REMOTE1
#set_location_assignment PIN_xx -to TAPE_REMOTE2
#
# Pantalla LCD 16x2 por I2C (PCF8574, LiquidCrystal_I2C); la direccion se
# elige en el OSD. Colector abierto: OJO, los modulos llevan resistencias a
# 5 V; alimentarlo a 3,3 V o con adaptador de niveles.
#set_global_assignment -name VERILOG_MACRO "NB_LCD=1"
#set_location_assignment PIN_xx -to LCD_SCL
#set_location_assignment PIN_xx -to LCD_SDA
#set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to LCD_SCL
#set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to LCD_SDA
